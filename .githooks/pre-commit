#!/bin/sh
set -eu
[ "$(git branch --show-current)" = "main" ] || exit 0
# Build only when the working source agrees with the staged source.
if ! git diff --quiet -- index.html images font scripts; then
  echo "배포할 index.html, images, font, scripts 변경을 먼저 스테이징해주세요." >&2
  exit 1
fi
if command -v node >/dev/null 2>&1; then
  node scripts/build-site.cjs
elif [ -x /opt/homebrew/bin/node ]; then
  /opt/homebrew/bin/node scripts/build-site.cjs
else
  echo "청첩장 빌드를 위해 Node.js가 필요합니다." >&2
  exit 1
fi
git add -- docs
